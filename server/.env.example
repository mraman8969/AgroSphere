# Spring Boot Configuration Template
SERVER_PORT=8080

# Supabase PostgreSQL Connection details
# Get these from your Supabase Dashboard: Settings -> Database -> Connection string (URI / JDBC)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_supabase_db_password

# Internal AI Microservice endpoint
AI_SERVICE_URL=http://localhost:8000
