# ==============================================================================
# AgroSphere - Shared Root Environment Template
# ==============================================================================
# Copy this file to .env in local environments where required.
# DO NOT put real passwords, production secrets, or API tokens in this file!
# ==============================================================================

# Supabase / Hosted PostgreSQL Database
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Spring Boot Backend (Main API)
SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# Python FastAPI (AI Services)
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# React Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_SERVICE_URL=http://localhost:8000
